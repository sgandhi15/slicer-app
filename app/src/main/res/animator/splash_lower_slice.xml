<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:ordering="together">
    <objectAnimator android:propertyName="translateX"
        android:valueFrom="8" android:valueTo="0" android:valueType="floatType"
        android:duration="1000" android:interpolator="@android:interpolator/fast_out_slow_in" />
    <objectAnimator android:propertyName="translateY"
        android:valueFrom="4" android:valueTo="0" android:valueType="floatType"
        android:duration="1000" android:interpolator="@android:interpolator/fast_out_slow_in" />
</set>
